# Keep real values in an ignored local env file or the Supabase secret manager.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_CALLBACK_URL=http://127.0.0.1:54321/functions/v1/google-calendar-callback
GOOGLE_CALENDAR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_CALENDAR_FRONTEND_URL=http://localhost:5173/calendar

# Generate a 32-byte key with: openssl rand -base64 32
# Keep previous version keys in this JSON map while stored tokens use them.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEYS={"v1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}
GOOGLE_CALENDAR_TOKEN_CURRENT_KEY_VERSION=v1
