# Optional comma-separated hostnames for development (no scheme, port, or path).
# Copy this file to .env.local and set your own Tailscale hostname.
# DEV_ALLOWED_HOSTS=your-machine.your-tailnet.ts.net
DEV_ALLOWED_HOSTS=

# Supabase API URL. For local development this is usually http://127.0.0.1:54321.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Copy the publishable/anon key from `npx supabase status` or the Supabase dashboard.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy API base path; /api uses the development or production reverse proxy.
VITE_API_URL=/api
# Temporary identity for the remaining Ktor-backed tasks until that domain is migrated.
VITE_USER_ID=00000000-0000-0000-0000-000000000101
